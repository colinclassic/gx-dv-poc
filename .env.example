# ==============================================================================
# ETL Data Quality Environment Configuration
# Copy this file to '.env' and populate with local/environment secrets.
# ==============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Data Source Connection Strings
# SQLite / DuckDB local file paths or DB URIs
RAW_DATA_DB_URL=sqlite:///./data/raw_data.db
STAGING_DATA_DB_URL=sqlite:///./data/staging_data.db
WAREHOUSE_DB_URL=postgresql://user:password@localhost:5432/analytics_db

# File Storage Paths
DATA_DIR=./data
OUTPUT_DOCS_DIR=./gx/uncommitted/data_docs

# Pipeline Alerting & Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
NOTIFICATION_EMAIL=data-quality@example.com

# Data Quality Thresholds
FAIL_PIPELINE_ON_CRITICAL=true
WARN_ON_NON_CRITICAL=true
